<?xml version="1.0" encoding="utf-8"?>
<!--
   Für Geräte vor Android 12: Die Thoska-Auslesungen und Kartennamen (Datenbank) bleiben auf diesem Gerät und gehen
   nicht in die Sicherung.
-->
<full-backup-content>
    <exclude
        domain="database"
        path="campus.db" />
    <exclude
        domain="database"
        path="campus.db-wal" />
    <exclude
        domain="database"
        path="campus.db-shm" />
</full-backup-content>
