<?xml version="1.0" encoding="utf-8"?>
<!--
   Was die App sichern darf. Die Thoska-Auslesungen und Kartennamen bleiben auf diesem Gerät (so steht es in der App):
   Sie gehen nicht in die Cloud-Sicherung. Beim direkten Umzug auf ein neues Gerät (device-transfer) bleiben sie erhalten.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="database"
            path="campus.db" />
        <exclude
            domain="database"
            path="campus.db-wal" />
        <exclude
            domain="database"
            path="campus.db-shm" />
        <!-- Verschlüsselte Zugangsdaten der Bibliothek („Angemeldet bleiben“): Der Schlüssel verlässt den Keystore nie. -->
        <exclude
            domain="sharedpref"
            path="paia_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Der Keystore-Schlüssel zieht nicht mit um, die Datei wäre auf dem neuen Gerät nicht lesbar. -->
        <exclude
            domain="sharedpref"
            path="paia_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
